{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "storefront": {
      "root": "apps/storefront"
    },
    "admin": {
      "root": "apps/admin"
    },
    "api": {
      "root": "apps/api",
      "entrypoint": "src/server.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "storefront"
      }
    }
  ]
}
