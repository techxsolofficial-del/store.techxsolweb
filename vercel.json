{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/storefront"
    },
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "dist/server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "web",
        "path": "/admin/index.html"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "web",
        "path": "/admin/index.html"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
