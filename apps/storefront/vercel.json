{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin/assets/:match*",
      "destination": "/admin/assets/:match*"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/assets/:match*",
      "destination": "/assets/:match*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
